# /etc/netplan/01-management.yaml
# Replace interface name and addresses before applying.
network:
  version: 2
  ethernets:
    ens18:
      dhcp4: false
      addresses:
        - 10.1.10.10/24
      routes:
        - to: default
          via: 10.1.10.1
      nameservers:
        addresses:
          - 1.1.1.1
          - 8.8.8.8
